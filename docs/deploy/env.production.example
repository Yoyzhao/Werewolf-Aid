# 生产环境变量模板（/etc/werewolf-aid/env）
# 权限：chown root:werewolf，chmod 640；不要把真实值提交到仓库。

NODE_ENV=production
APP_VERSION=0.1.0

# 监听
HOST=0.0.0.0
# Node 直连 TLS：443；云 LB 回源：3000
PORT=443

# 对外访问源（必须与实际浏览器地址一致，含协议与端口）
PUBLIC_ORIGIN=https://werewolf.example.com

# 会话签名；生成：openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# TLS：Node 直连模式开启；云 LB 终止 TLS 时设为 0
HTTPS_ENABLED=1
TLS_KEY_PATH=/etc/werewolf-aid/tls/privkey.pem
TLS_CERT_PATH=/etc/werewolf-aid/tls/fullchain.pem

# HTTP→HTTPS 跳转端口；Node 直连 TLS 且占用 80 时设为 80；云 LB 模式设为 0
HTTP_REDIRECT_PORT=80

# 前端构建产物
WEB_DIST_DIR=/opt/werewolf-aid/current/apps/web/dist

# 云 LB/CDN 场景设为 1，直连时保持 0
TRUST_PROXY=0

# 请求与超时限制（默认值，可按需覆盖）
BODY_LIMIT_BYTES=262144
REQUEST_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=20000
CONNECTION_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=65000

# AI 中转限制
AI_BODY_LIMIT_BYTES=131072
AI_RELAY_CONNECT_TIMEOUT_MS=30000
AI_RELAY_TOTAL_TIMEOUT_MS=60000
AI_RELAY_MAX_RESPONSE_BYTES=1048576
AI_MAX_INFLIGHT_PER_SESSION=1
AI_MAX_INFLIGHT_GLOBAL=20
RATE_LIMIT_AI_PER_MIN=10

# 会话有效期（毫秒，默认 7 天）
SESSION_TTL_MS=604800000

# SQLite（P1）：目录需由服务账号可写；默认 ./data/lrs.sqlite
SQLITE_FILE=/var/lib/werewolf-aid/lrs.sqlite

# 房间生命周期与限频
ROOM_TTL_MS=86400000
ROOM_JOIN_TTL_MS=600000
ROOM_CLEANUP_INTERVAL_MS=60000
RATE_LIMIT_ROOM_CREATE_PER_HOUR=10
RATE_LIMIT_ROOM_JOIN_PER_MIN=30
RATE_LIMIT_ROOM_HOST_PER_MIN=120

# WebSocket 单条消息上限（默认 64KB）
WS_MAX_PAYLOAD_BYTES=65536
